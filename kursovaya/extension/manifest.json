{
  "manifest_version": 3,
  "name": "Фишинг-детектор",
  "version": "1.3",
  "description": "Автоматически анализирует письма в Яндекс.Почте на фишинг",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://mail.yandex.ru/*",
    "https://mail.yandex.com/*",
    "https://gigachat.devices.sberbank.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.yandex.ru/*",
        "https://mail.yandex.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}